%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "DejaVu Sans, Verdana, sans-serif",
    "fontSize": "15px",
    "background": "#0e0f13",
    "primaryColor": "#1d2029",
    "primaryTextColor": "#e9ebf0",
    "primaryBorderColor": "#2d3240",
    "secondaryColor": "#16181f",
    "tertiaryColor": "#16181f",
    "lineColor": "#5b6170",
    "textColor": "#9197a6",
    "clusterBkg": "#16181f",
    "clusterBorder": "#272a35",
    "titleColor": "#9197a6",
    "edgeLabelBackground": "#0e0f13"
  },
  "flowchart": { "curve": "basis", "padding": 22, "nodeSpacing": 30, "rankSpacing": 60, "diagramPadding": 28, "htmlLabels": true, "wrappingWidth": 260 }
}}%%
flowchart TB
  team(["<b>Teams</b><br/><span style='color:#9197a6'>portal · kubectl · GitOps&nbsp;&nbsp;</span>"])

  subgraph cp["CONTROL PLANE"]
    direction LR
    portal["<b>Portal</b><br/><span style='color:#9197a6'>Backstage&nbsp;&nbsp;</span>"]
    xr["<b>Crossplane</b><br/><span style='color:#9197a6'>PostgresCluster · Project · Location&nbsp;&nbsp;</span>"]
    fn["<b>function-basis</b><br/><span style='color:#9197a6'>composes every site&nbsp;&nbsp;</span>"]
    obs["<b>Observability</b><br/><span style='color:#9197a6'>Prometheus · Grafana per Project&nbsp;&nbsp;</span>"]
    portal --> xr --> fn
    fn ~~~ obs
  end

  subgraph loc["LOCATIONS"]
    direction LR
    pg1["<b>PostgreSQL</b><br/><span style='color:#9197a6'>protected · primary + standbys&nbsp;&nbsp;</span>"]
    bucket[("<b>Backup bucket</b><br/><span style='color:#9197a6'>per Project · COSI&nbsp;&nbsp;</span>")]
    pg2["<b>PostgreSQL</b><br/><span style='color:#9197a6'>recovery · replica cluster&nbsp;&nbsp;</span>"]
    pg1 == "WAL + backups" ==> bucket
    bucket == "replays WAL" ==> pg2
  end

  team --> cp
  cp -- "deploys every site" --> loc
  cp <-.-|"▲ metrics"| loc

  classDef node fill:#1d2029,stroke:#2d3240,stroke-width:1px,color:#e9ebf0,rx:10,ry:10
  classDef db fill:#0f2a12,stroke:#00c300,stroke-width:1.5px,color:#e9ebf0,rx:10,ry:10
  classDef store fill:#1d2029,stroke:#00c300,stroke-width:1px,color:#e9ebf0
  classDef actor fill:#0e0f13,stroke:#5b6170,stroke-width:1px,color:#e9ebf0,stroke-dasharray:3 3
  class portal,xr,fn,obs node
  class pg1,pg2 db
  class bucket store
  class team actor

  style cp fill:#16181f,stroke:#272a35,stroke-width:1px,color:#9197a6,rx:14,ry:14
  style loc fill:#16181f,stroke:#272a35,stroke-width:1px,color:#9197a6,rx:14,ry:14

  linkStyle 0,1 stroke:#5b6170,stroke-width:1.2px
  linkStyle 3,4 stroke:#00c300,stroke-width:2.2px
  linkStyle 5,6 stroke:#9197a6,stroke-width:1.2px
  linkStyle 7 stroke:#5b6170,stroke-width:1.2px,stroke-dasharray:4 4
